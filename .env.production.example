# Copiar como /opt/flacso/preinscripcionesFLACSOUY/.env.production en el servidor.
# Este archivo es una referencia: no incluir valores reales en Git.

POSTGRES_DB=preinscripciones_flacsouy
POSTGRES_USER=preinscripciones_app
POSTGRES_PASSWORD=REEMPLAZAR_POR_UN_SECRETO_LARGO
DATABASE_URL=postgres://preinscripciones_app:REEMPLAZAR_POR_UN_SECRETO_LARGO@postgres:5432/preinscripciones_flacsouy

WORDPRESS_URL=https://flacso.edu.uy

GOOGLE_OIDC_CLIENT_ID=REEMPLAZAR_SI_NO_SE_USA_EL_ARCHIVO_OAUTH
GOOGLE_OIDC_CLIENT_SECRET=REEMPLAZAR_SI_NO_SE_USA_EL_ARCHIVO_OAUTH
# Opcional: el frontend envía el callback según el dominio desde el que se abre.
GOOGLE_OIDC_REDIRECT_URI=https://preinscripciones.flacso.edu.uy/accounts/google/login/callback/
ADMIN_ALLOWED_EMAILS=web@flacso.edu.uy
# Clave maestra para descifrar la configuración SES cifrada en PostgreSQL.
# Debe cargarse como secreto real en el servidor; no usar este placeholder.
APP_SETTINGS_ENCRYPTION_KEY=REEMPLAZAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO
SECRETS_DIR=/opt/flacso/preinscripcionesFLACSOUY/.secrets

# Puerto local del servidor para que Apache haga ProxyPass hacia la nueva app.
# No usar 3200: pertenece a la plataforma legacy.
WEB_PORT=3300
