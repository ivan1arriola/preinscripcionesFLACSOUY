{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts",
    "worker:notifications": "tsx src/worker-notifications.ts",
    "migrate:spreadsheets": "tsx ../../scripts/migrate-spreadsheets.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1146.0",
    "@flacso/contracts": "workspace:*",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^11.1.0",
    "kysely": "^0.27.5",
    "libphonenumber-js": "^1.13.14",
    "nodemailer": "^10.0.14",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
