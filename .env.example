# ==========================================
# Configuración del Sistema de Preinscripciones
# ==========================================

# Base de datos PostgreSQL (Variable de entorno obligatoria)
POSTGRES_PORT=5433
DATABASE_URL=postgres://flacso:flacso_password@localhost:5433/flacso_preinscripciones

# Catálogo WordPress (dejar vacío para utilizar el catálogo de pruebas local)
WORDPRESS_URL=https://flacso.edu.uy
# Igual a FLACSO_PREINSCRIPCIONES_CATALOG_TOKEN en wp-config.php; habilita los correos de notificación de las ofertas. No commitear el valor.
WORDPRESS_CATALOG_TOKEN=

# Administradores institucionales autorizados (separados por coma)
ADMIN_ALLOWED_EMAILS=web@flacso.edu.uy

# Clave maestra para descifrar la configuración sensible (SMTP, Telegram) almacenada en PostgreSQL.
# Cadena hexadecimal de 64 caracteres (32 bytes para AES-256-GCM). Generar con: openssl rand -hex 32
# Generar una clave distinta para cada entorno; no versionar el valor real.
APP_SETTINGS_ENCRYPTION_KEY=REEMPLAZAR_CON_CLAVE_LOCAL_HEX_64_CHARS

# Requiere Delegación de autoridad en todo el dominio autorizada por Google Workspace.
GOOGLE_SERVICE_ACCOUNT_SUBJECT=web@flacso.edu.uy

# NOTAS DE CONFIGURACIÓN:
# 1. Credenciales de Google (Drive, Sheets y Login OIDC):
#    El sistema las detecta automáticamente desde la carpeta .secrets/ :
#    - .secrets/google-service-account.json (Cuenta de servicio para Drive y Sheets)
#    - .secrets/google-oauth-web-client.json (Cliente web OAuth para Login de Google)
#
# 2. Carpeta de Google Drive para Documentación:
#    Se gestiona y edita dinámicamente desde la interfaz web del Panel de Administración (/admin/perfiles).
# Set only to a disposable PostgreSQL 17 database to run integration tests.
PREINSCRIPTIONS_TEST_DATABASE_URL=

# Meta (SubmitApplication por Pixel + Conversions API). Sin ambos valores no se envia nada.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Google Analytics 4 (ID de medicion; vacio = sin GA4).
GA4_MEASUREMENT_ID=
