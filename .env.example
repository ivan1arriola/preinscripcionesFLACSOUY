# ==============================================================================
# FLACSO Uruguay - Preinscripciones - Variables de Entorno (.env)
# ==============================================================================
# Copie este archivo como .env y complete con los valores correspondientes al entorno.
# NUNCA suba al control de versiones valores reales ni credenciales de producción.

# --- Servidor y Aplicación ---
NODE_ENV=production
PORT=3000
CORS_ALLOWED_ORIGINS=https://flacso.edu.uy,https://preinscripciones.flacso.edu.uy

# --- PostgreSQL (Base Técnica 3FN) ---
# En Docker Compose interno se usa postgres:5432.
# En host local se mapea por defecto al puerto 5433 para evitar colisiones.
DATABASE_URL=postgres://flacso:flacso_secure_pass_change_me@postgres:5432/flacso_preinscriptions
POSTGRES_DB=flacso_preinscriptions
POSTGRES_USER=flacso
POSTGRES_PASSWORD=flacso_secure_pass_change_me
POSTGRES_PORT=5433

# --- WordPress REST API v1 (Fuente de Verdad Académica) ---
# Si no se define WORDPRESS_URL, el sistema utiliza fixtures locales de respaldo.
WORDPRESS_URL=https://flacso.edu.uy
WORDPRESS_CACHE_TTL_SECONDS=300

# --- Panel de Administración y Seguridad ---
# Credenciales para el administrador único del sistema.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_secure_admin_password
ADMIN_SESSION_SECRET=change_this_random_32_character_secret_key_flacso
RATE_LIMIT_MAX_PER_MINUTE=300

# --- Almacenamiento Temporal de Archivos ---
# Directorio fuera del DocumentRoot de la web para archivos temporales subidos.
# TTL de expiración automática: 30 minutos sin actividad.
UPLOADS_DIR=/data/uploads
MAX_FILE_SIZE_BYTES=10485760

# --- Integración Google (Sheets y Drive) ---
# Credenciales de Service Account con permisos en las carpetas y planillas.
GOOGLE_CLIENT_EMAIL=service-account@flacso-uruguay.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_ROOT_FOLDER_ID=1abcXYZ_flacso_drive_root_folder_id
