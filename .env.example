# ==========================================
# Configuración del Sistema de Preinscripciones
# ==========================================

# Base de datos PostgreSQL interna
POSTGRES_PORT=5433
DATABASE_URL=postgres://flacso:flacso_password@localhost:5433/flacso_preinscripciones

# Catálogo WordPress (si se omite o queda vacío, usa fixtures locales)
WORDPRESS_URL=https://flacso.edu.uy

# Google Drive (Carpeta institucional destino para documentación de preinscripciones)
# Carpeta oficial: https://drive.google.com/drive/u/3/folders/1hxhuUoIyoocL-laSfD3A8rgLigUgOH4e
GOOGLE_DRIVE_FOLDER_ID=1hxhuUoIyoocL-laSfD3A8rgLigUgOH4e

# Token de acceso o Service Account para Google Drive
GOOGLE_ACCESS_TOKEN=

# Google OIDC (Autenticación administrativa exclusiva institucional)
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=http://localhost:5173/admin/perfiles
ADMIN_ALLOWED_EMAILS=web@flacso.edu.uy
